rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function activeSubscription(uid) {
      return owner(uid)
        && exists(/databases/$(database)/documents/users/$(uid)/subscription/info)
        && get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.subscriptionStatus == "SUBSCRIBED"
        && get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.expiresAt is timestamp
        && get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.expiresAt > request.time;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid);
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "username", "email", "lastSyncAt", "totalOrders", "totalPayments"
        ]);
      allow delete: if owner(uid);

      match /subscription/info {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /workshops/{docId} {
        allow read, write: if activeSubscription(uid);
      }

      match /orders/{docId} {
        allow read, write: if activeSubscription(uid);
      }

      match /payments/{docId} {
        allow read, write: if activeSubscription(uid);
      }

      match /presets/{docId} {
        allow read, write: if activeSubscription(uid);
      }

      match /unitRules/{docId} {
        allow read, write: if activeSubscription(uid);
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /subscriptionPurchases/{tokenHash} {
      allow read, write: if false;
    }
  }
}
