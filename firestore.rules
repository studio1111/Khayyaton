rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function activeSubscription(uid) {
      return owner(uid)
        && exists(/databases/$(database)/documents/users/$(uid)/subscription/info)
        && (
          get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.subscriptionStatus == "ADMIN_GRANTED"
          || (
            get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.expiresAt is timestamp
            && get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.expiresAt > request.time
            && (
              get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.subscriptionStatus == "SUBSCRIBED"
              || get(/databases/$(database)/documents/users/$(uid)/subscription/info).data.subscriptionStatus == "TRIAL_ACTIVE"
            )
          )
        );
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          "username",
          "email",
          "lastSyncAt",
          "totalOrders",
          "totalPayments"
        ])
        && "username" in data
        && "email" in data
        && data.username is string
        && data.email is string;
    }

    match /users/{uid} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && validUserProfile(request.resource.data);

      allow update: if owner(uid)
        && validUserProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "username",
          "email",
          "lastSyncAt",
          "totalOrders",
          "totalPayments"
        ]);

      allow delete: if owner(uid);

      match /subscription/info {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(["subscriptionStatus", "trialStartedAt", "expiresAt", "source"])
          && request.resource.data.subscriptionStatus == "TRIAL_ACTIVE"
          && request.resource.data.trialStartedAt is timestamp
          && request.resource.data.trialStartedAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(3, "d")
          && request.resource.data.source == "khayyaton_account_trial";
        allow update, delete: if false;
      }

      match /workshops/{workshopId} {
        allow read, write: if activeSubscription(uid);
      }

      match /orders/{orderId} {
        allow read, write: if activeSubscription(uid);
      }

      match /payments/{paymentId} {
        allow read, write: if activeSubscription(uid);
      }

      match /presets/{presetId} {
        allow read, write: if activeSubscription(uid);
      }

      match /unitRules/{ruleId} {
        allow read, write: if activeSubscription(uid);
      }
    }

    match /usernames/{username} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["uid"])
        && "uid" in request.resource.data
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /subscriptionPurchases/{tokenHash} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
